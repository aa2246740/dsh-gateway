{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM"],
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "jsx": "react-jsx",
  },
  "include": [
    "src/**/*.ts"
  ]
}
